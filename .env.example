# Turso (libsql) connection — copy to .env and fill in real values
TURSO_URL=libsql://your-db-your-org.region.turso.io
TURSO_TOKEN=

# Single-user admin login (/god area). ADMIN_PASSWORD_HASH is a bcrypt hash of
# your password, not the password itself. Generate it once, e.g.:
#   go run ./cmd/hashpass 'your-password'
# IMPORTANT: wrap the hash in single quotes. Unquoted, the '$' characters in a
# bcrypt hash are treated as variable references and silently stripped, which
# makes every login fail.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=''

# Optional: session lifetime in hours (default 30 days)
# SESSION_TTL_HOURS=720

# Optional: backup settings (defaults shown)
# Backups run daily (24h interval) when BACKUP_ACTIVE=1.
# BACKUP_ACTIVE=1  # Set to 1 to enable daily backups. Disabled by default if unset.
# BACKUP_RUN_ON_STARTUP=1  # Set to 1 to run backup immediately on server start.
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=7

# Optional: CardDAV settings (sovereign contact backup)
# Generate a token hash with: go run ./cmd/hashpass 'your-carddav-token'
# CARDDAV_TOKEN_HASH=''
