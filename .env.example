# Turso (libsql) connection — copy to .env and fill in real values
TURSO_URL=libsql://your-db-your-org.region.turso.io
TURSO_TOKEN=

# Single-user admin login (/god area). ADMIN_PASSWORD_HASH is a bcrypt hash of
# your password, not the password itself. Generate it once, e.g.:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Optional: session lifetime in hours (default 30 days)
# SESSION_TTL_HOURS=720
